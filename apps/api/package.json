{
  "name": "@inner-almox/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --clean",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@supabase/supabase-js": "^2.112.1",
    "bullmq": "^6.0.11",
    "exceljs": "^4.4.0",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.8.1",
    "pdfkit": "^0.20.1",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
